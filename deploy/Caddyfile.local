# Preview de PRODUÇÃO local (docker compose --profile preview up preview → :8080).
# Reproduz o COMPORTAMENTO do bloco de produção (deploy/Caddyfile, VPS): Range nos
# tiles, compressão só fora de /tiles, sem cache (sempre vê o build fresco).
#
# Diferença estrutural: aqui app e tiles vêm de volumes separados (/srv/app e
# /srv/tiles), então roteamos com handle_path. Na VPS, tiles é subpasta do root.
# ⚠️ Mantenha o comportamento em sync com deploy/Caddyfile.

:80 {
	# Comprime tudo MENOS os tiles (PMTiles usa Range requests — comprimir quebra).
	@notiles not path /tiles/*
	encode @notiles gzip zstd

	# Preview sempre fresco (na VPS os tiles têm cache longo).
	header Cache-Control "no-store"


	# Endurecimento — o MESMO do deploy/Caddyfile, com uma diferença LOCAL: o
	# connect-src aceita o host de tiles local (:8081), que o build de dev usa.
	# É aqui que a CSP se prova antes de ir para a VPS: abra :8080 e olhe o
	# console — em Report-Only, violação aparece sem quebrar nada.
	header {
		# O Caddy anuncia a si mesmo por padrão. Versão de servidor é informação
		# para quem varre, não para quem navega.
		-Server
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		# Zero DESLIGA o auditor legado do XSS, que é o recomendado: ele próprio
		# já foi vetor. A defesa é a CSP abaixo.
		X-XSS-Protection "0"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Nada no app usa câmera, microfone ou localização — verificado no código
		# antes de bloquear.
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		# ⚠️ REPORT-ONLY de propósito: a CSP é o único header aqui capaz de apagar
		# o mapa, e provar que ela não apaga exige um navegador. Em Report-Only o
		# browser NÃO bloqueia nada e denuncia no console o que bloquearia. Vira
		# `Content-Security-Policy` (sem o sufixo) depois de uma passagem pelo
		# preview local com o console limpo — ver HERANCA §7, pendência 1.
		Content-Security-Policy-Report-Only "default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; frame-ancestors 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://server.arcgisonline.com https://protomaps.github.io; font-src 'self' data:; worker-src 'self' blob:; child-src 'self' blob:; connect-src 'self' http://localhost:8081 https://tiles.averisen.com https://protomaps.github.io"
	}

	# Tiles → volume próprio (strip do prefixo /tiles).
	handle_path /tiles/* {
		root * /srv/tiles
		file_server
	}

	# App (index.html + assets).
	handle {
		root * /srv/app
		file_server
	}
}
