# Cliente 1 — o que a VPS serve hoje.
#
# Os valores aqui são os que ESTÃO em produção desde 2026-06-28, transcritos do
# que já estava cravado no `deploy.sh`, no `geo-agent.service` e no `Caddyfile`.
# Nenhum ajuste "de passagem": o render deste cliente reproduz o bloco de Caddy
# atual byte a byte, e é assim que se sabe que a fase 6 não mexeu no que está no ar.

DOMINIO=geo-intelligence.averisen.com

# Onde o build estático mora na VPS.
CAMINHO_APP=/var/www/geo

# Onde o agente mora, relativo à home do usuário do ssh.
CAMINHO_AGENTE=projects/geo

# Unit do systemd e porta em que o agente escuta (só em 127.0.0.1).
SERVICO=geo-agent
PORTA_AGENTE=8000

# Portão (basic auth no Caddy).
#
# LIGADO desde 2026-08-31, por decisão do Guilherme. Ficou vazio até aqui porque
# fechar um site já público é decisão de produto e não de deploy — e essa decisão
# veio: o cliente 1 é aplicação da casa, não contrato, então não há terceiro a
# avisar. O que a motivou foi custo, não sigilo: o `/api/chat` estava na internet
# sem credencial, e cada pergunta chama um modelo e gasta dinheiro. Ver §8 do
# ADR-0001 do `webgis`.
#
# Só o hash mora aqui. A senha em claro vive no `agent/.env.geo-analytics`, que
# não é versionado — e é de lá que o vigia a lê para não alertar sobre um site
# que está de pé atrás do portão.
PORTAO_USUARIO=geo-intelligence
PORTAO_HASH='$2a$14$zLfrRpSxy5Ux2WjNeOkcseGSA0D9vP/axQCrHII/t/y.c6ec8ysIq'
