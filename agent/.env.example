# Copie para .env (gitignored) e preencha. O backend le este arquivo no startup.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Conexao do geodata (PostGIS central) — o agente le os numeros do IBGE de la.
# Papel de leitura: geo_reader. Sem esta variavel o backend nao sobe.
GEODATA_DSN=postgresql://geo_reader:SENHA@localhost:55432/geodata
