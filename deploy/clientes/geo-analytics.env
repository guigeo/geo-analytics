# Cliente 1 — o que a VPS serve hoje.
#
# Os valores aqui são os que ESTÃO em produção desde 2026-06-28, transcritos do
# que já estava cravado no `deploy.sh`, no `geo-agent.service` e no `Caddyfile`.
# Nenhum ajuste "de passagem": o render deste cliente reproduz o bloco de Caddy
# atual byte a byte, e é assim que se sabe que a fase 6 não mexeu no que está no ar.

DOMINIO=geo-intelligence.averisen.com

# Onde o build estático mora na VPS.
CAMINHO_APP=/var/www/geo

# Onde o agente mora, relativo à home do usuário do ssh.
CAMINHO_AGENTE=projects/geo

# Unit do systemd e porta em que o agente escuta (só em 127.0.0.1).
SERVICO=geo-agent
PORTA_AGENTE=8000

# Portão (basic auth no Caddy). VAZIO = site aberto, que é o estado de hoje.
# Ligar aqui fecha um site que hoje é público: é decisão de produto, não de
# deploy, e por isso não vem ligado de fábrica. Ver §8 do ADR-0001 do `webgis`.
PORTAO_USUARIO=
PORTAO_HASH=
