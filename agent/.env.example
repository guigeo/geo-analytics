# Copie para .env (gitignored) e preencha. O backend le este arquivo no startup.

# Qual cliente esta instancia serve: um arquivo de geo_agent/clientes/<id>.toml.
# Um processo, um cliente. Sem a variavel, o cliente 1 — o comportamento de
# sempre. `make agente CLIENTE=eb-prime PORTA_IA=8001` sobe o segundo ao lado.
CLIENTE=geo-analytics

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Conexao do geodata (PostGIS central) — o agente le os numeros do IBGE de la.
# Papel de leitura: geo_reader. Sem esta variavel o backend nao sobe.
GEODATA_DSN=postgresql://geo_reader:SENHA@localhost:55432/geodata
