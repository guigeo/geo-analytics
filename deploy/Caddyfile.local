# Preview de PRODUÇÃO local (docker compose --profile preview up preview → :8080).
# Reproduz o COMPORTAMENTO do bloco de produção (deploy/Caddyfile, VPS): Range nos
# tiles, compressão só fora de /tiles, sem cache (sempre vê o build fresco), /api
# entregue ao agente — e, desde a fase 5, o portão de acesso na frente de tudo.
#
# Diferença estrutural: aqui app e tiles vêm de volumes separados (/srv/app e
# /srv/tiles), então roteamos com handle_path. Na VPS, tiles é subpasta do root.
# ⚠️ Mantenha o comportamento em sync com deploy/Caddyfile.

:80 {
	# ── Sem portão aqui, desde 2026-09-06 ─────────────────────────────────────
	# Este arquivo espelha o `Caddyfile.modelo`, e o modelo perdeu o `basicauth`
	# quando o portão virou SESSÃO no agente (emenda de 2026-09-06 à §9 do ADR-0001
	# do `webgis`). O preview perde junto: ele existe para mostrar exatamente o que
	# a VPS vai servir, e um preview que pede senha onde a produção não pede
	# deixaria de cumprir a única função que tem.
	#
	# Para exercitar o portal no preview é preciso o agente de pé (`make agente`) e
	# uma conta no `app_clientes` local — o `/api` responde 401 sem sessão, aqui
	# igual a lá.

	# Chat: o agente roda NATIVO no host (make agente), não em container. Espelha
	# o que a VPS faz — lá o Caddy entrega /api ao systemd geo-agent em :8000 —, e
	# a porta vem do ambiente porque agora existe um agente por cliente.
	handle /api/* {
		reverse_proxy host.docker.internal:{$PORTA_AGENTE:8000}
	}

	# Comprime tudo MENOS os tiles (PMTiles usa Range requests — comprimir quebra).
	@notiles not path /tiles/*
	encode @notiles gzip zstd

	# Preview sempre fresco (na VPS os tiles têm cache longo).
	header Cache-Control "no-store"


	# Endurecimento — o MESMO do deploy/Caddyfile, com uma diferença LOCAL: o
	# connect-src aceita o host de tiles local (:8081), que o build de dev usa.
	# Aqui a CSP também é enforcing: se uma origem nova entrar no app, é para
	# quebrar no preview, não em produção.
	header {
		# O Caddy anuncia a si mesmo por padrão. Versão de servidor é informação
		# para quem varre, não para quem navega.
		-Server
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		# Zero DESLIGA o auditor legado do XSS, que é o recomendado: ele próprio
		# já foi vetor. A defesa é a CSP abaixo.
		X-XSS-Protection "0"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Nada no app usa câmera, microfone ou localização — verificado no código
		# antes de bloquear.
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		# ENFORCING (o nome do header não tem sufixo). Entrou em Report-Only em
		# 2026-08-22 — é o único header aqui capaz de apagar o mapa — e virou
		# bloqueio de verdade no mesmo dia, depois de uma navegação real com o
		# console limpo. O comentário antigo ainda dizia Report-Only e foi
		# corrigido em 2026-08-30. Ver HERANCA §7, pendência 1.
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; frame-ancestors 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://server.arcgisonline.com https://protomaps.github.io; font-src 'self' data:; worker-src 'self' blob:; child-src 'self' blob:; connect-src 'self' http://localhost:8081 https://tiles.averisen.com https://protomaps.github.io https://server.arcgisonline.com"
	}

	# Tiles → volume próprio (strip do prefixo /tiles).
	handle_path /tiles/* {
		root * /srv/tiles
		file_server
	}

	# App (index.html + assets).
	handle {
		root * /srv/app
		file_server
	}
}
