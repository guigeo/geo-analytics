# MODELO do bloco de site de UM cliente — apêndice ao /etc/caddy/Caddyfile da VPS.
# A VPS já roda Caddy servindo outros sites; NÃO substitua o arquivo, apenas
# acrescente o bloco renderizado. Ver deploy/README.md e ../webgis/docs/VPS.md.
#
# Renderize antes de usar (o arquivo com {{…}} não é config válida):
#   ./deploy/renderizar.sh deploy/Caddyfile.modelo eb-prime
#
# Este arquivo é a FONTE do que está em produção. Em 2026-08-20 ele ficou para
# trás: os tiles saíram daqui para tiles.averisen.com, o bloco foi corrigido à mão
# na VPS e ninguém trouxe a correção de volta. Descoberto em 2026-08-22 por um diff
# contra o servidor. Editar aqui, mandar para lá — nunca o contrário.
#
# Até 2026-08-30 este era o `deploy/Caddyfile`, com o cliente 1 cravado. Virou
# modelo na fase 6 do passo 5 do ADR-0001; o render do cliente 1 reproduz aquele
# arquivo diretiva por diretiva, e é isso que garante que a VPS não mudou.
#
# Layout na VPS (por cliente, vindo de deploy/clientes/<id>.env):
#   {{CAMINHO_APP}}  -> build do frontend (index.html, assets/…)
#   ~/{{CAMINHO_AGENTE}}  -> agente de IA (lê o geodata por GEODATA_DSN)
#   os tiles NÃO moram aqui: host compartilhado, ver ../../webgis/docs/VPS.md

{{DOMINIO}} {
{{#SE PORTAO_USUARIO}}
	# ── Portão ────────────────────────────────────────────────────────────────
	# Credencial por APLICAÇÃO (não por pessoa), decidida na emenda de 2026-08-29
	# da §8 do ADR-0001 do `webgis`. O motivo é custo, não sigilo: cada pergunta
	# ao /api/chat chama um modelo. Site aberto é ausência de PORTAO_USUARIO no
	# deploy/clientes/<id>.env — o cliente 1 é assim hoje, e ligar o portão nele
	# fecharia um site que está público: decisão de produto, não de deploy.
	#
	# ⚠️ `basicauth` e NÃO `basic_auth`: o Caddy da VPS é 2.6.2 (medido em
	# 2026-08-30), onde o nome novo não existe e o `validate` recusa o arquivo
	# INTEIRO — que é compartilhado com os outros sites da máquina. Quando o
	# Caddy de lá subir para 2.8+, isto vira `basic_auth`. Ver webgis/docs/VPS.md.
	#
	# Só o hash mora no repositório; a senha em claro, em lugar nenhum.
	basicauth {
		{{PORTAO_USUARIO}} {{PORTAO_HASH}}
	}

{{/SE}}
	# Chat IA: agente FastAPI local (systemd {{SERVICO}}, :{{PORTA_AGENTE}}).
	@api path /api/*
	reverse_proxy @api 127.0.0.1:{{PORTA_AGENTE}}

	root * {{CAMINHO_APP}}
	file_server

	# Os tiles não são mais servidos daqui: vivem em tiles.averisen.com, o host
	# compartilhado. A compressão volta a ser irrestrita — não há mais Range de
	# PMTiles neste site para proteger.
	encode gzip zstd

	# Assets com hash no nome: cache agressivo.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# Endurecimento portado do Nginx do webgis-core — pendência 1 do HERANCA. O
	# conteúdo é o de lá; o servidor é este, porque é este que está de pé.
	header {
		# O Caddy anuncia a si mesmo por padrão. Versão de servidor é informação
		# para quem varre, não para quem navega.
		-Server
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		# Zero DESLIGA o auditor legado do XSS, que é o recomendado: ele próprio
		# já foi vetor. A defesa é a CSP abaixo.
		X-XSS-Protection "0"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Nada no app usa câmera, microfone ou localização — verificado no código
		# antes de bloquear.
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		# ENFORCING desde 2026-08-22. Entrou em Report-Only no mesmo dia — é o único
		# header aqui capaz de apagar o mapa — e virou bloqueio de verdade depois de
		# uma navegação real no site publicado, com camadas, satélite, busca e chat,
		# sem uma violação no console. Se algum dia faltar origem, o sintoma é mapa
		# ou basemap sumindo, e o console diz qual diretiva barrou. Ver HERANCA §7.
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; frame-ancestors 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://server.arcgisonline.com https://protomaps.github.io; font-src 'self' data:; worker-src 'self' blob:; child-src 'self' blob:; connect-src 'self' https://tiles.averisen.com https://protomaps.github.io https://server.arcgisonline.com"
	}
}
