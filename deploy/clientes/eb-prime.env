# Cliente 2 — EB Prime.
#
# Nada aqui está em produção. O que este arquivo prova é que o deploy sabe que
# existe mais de um cliente; publicar é decisão do Guilherme, e depende de coisas
# que não são código (DNS, domínio, CORS do host de tiles).

# Decidido pelo Gui em 2026-08-30: SUBDOMÍNIO, não a raiz. A raiz do
# `ebprime.com.br` fica para o site institucional do cliente — um endereço aponta
# para um lugar só, e publicar o mapa na raiz derrubaria o site dele.
#
# Consequência que vem junto: este é domínio PRÓPRIO, não subdomínio de
# averisen.com, e o host de tiles compartilhado só libera CORS para
# `*.averisen.com` (`webgis/infra/tiles/Caddyfile.prod`). Ele precisa entrar
# naquela allowlist antes de a aplicação funcionar, e ISSO é mudança em
# produção — o host serve o cliente 1 hoje.
DOMINIO=app.ebprime.com.br

CAMINHO_APP=/var/www/eb-prime
CAMINHO_AGENTE=projects/eb-prime

# Nome próprio de unit: dois agentes na mesma VPS, um por cliente, portas
# distintas. Ambos só em 127.0.0.1 — quem expõe é o Caddy.
SERVICO=eb-prime-agent
PORTA_AGENTE=8001

# Portão ligado desde o nascimento: o site dele não nasce aberto na internet.
# Só o hash mora aqui; a senha em claro não entra no repositório.
PORTAO_USUARIO=eb-prime
PORTAO_HASH='$2a$14$uEChwrN0f.oRdoCd4YhZa.hzl.orc4r5ppRcSRI8IeqXpQcFGl5sW'
