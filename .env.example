# Copie para .env (ignorado pelo git).

# Diretório do host de tiles compartilhado — os .pmtiles NÃO moram mais neste
# repositório. É de lá que o pipeline escreve, o preview serve e o deploy envia.
# Ver ../webgis/docs/LOCAL.md.
TILES_DIR=/Users/gui_ramos/dados-webgis/tiles

# Build do Protomaps a usar no basemap (opcional; builds expiram ~90 dias).
# PROTOMAPS_BUILD_URL=https://build.protomaps.com/20250602.pmtiles

# Conexao do geodata (PostGIS central) para o pipeline. Dentro do container o banco
# nao e localhost — e o host. O agente, que roda direto na maquina, usa localhost no
# proprio agent/.env: mesma coisa logica, dois enderecos, porque sao redes diferentes.
GEODATA_DSN=postgresql://geo_reader:SENHA@host.docker.internal:55432/geodata
